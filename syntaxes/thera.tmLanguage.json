{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thera",
  "scopeName": "source.thera",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.thera",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.thera",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.thera",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.thera"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.thera"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.thera",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.thera",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.thera"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.thera"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.thera",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.thera"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.thera"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.thera",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.thera",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.thera"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.thera"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.annotation.thera",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
          "captures": {
            "0": {
              "name": "entity.name.tag.decorator.thera"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.thera",
          "match": "\\b(return|throw|if|else|for|in|while|match|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.thera",
          "match": "\\b(let|mut|const|pub|fn|type|struct|interface|enum|impl|native)\\b"
        },
        {
          "name": "keyword.other.import.thera",
          "match": "\\b(import|as)\\b"
        },
        {
          "name": "variable.language.self.thera",
          "match": "\\bself\\b"
        },
        {
          "name": "variable.language.wildcard.thera",
          "match": "\\b_\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.thera",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.void.thera",
          "match": "\\bvoid\\b"
        },
        {
          "name": "constant.language.variant.thera",
          "match": "\\b(Ok|Err|Some|None)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.thera",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "entity.name.namespace.thera",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.(?=[a-zA-Z_])"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.thera"
            },
            "2": {
              "name": "entity.name.function.thera"
            }
          }
        },
        {
          "name": "entity.name.function.thera",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.thera",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.thera",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.thera",
          "match": "->|=>|\\?|\\.\\.|==|!=|<=|>=|&&|\\|\\||[=+\\-*/%!<>]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.thera",
          "match": ",|\\.|:"
        },
        {
          "name": "punctuation.terminator.thera",
          "match": ";"
        },
        {
          "name": "punctuation.section.bracket.round.thera",
          "match": "\\(|\\)"
        },
        {
          "name": "punctuation.section.bracket.square.thera",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.section.bracket.curly.thera",
          "match": "\\{|\\}"
        }
      ]
    }
  }
}
